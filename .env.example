# Copy this file to .env.local for local development.
# Keep real credentials in .env.local, Vercel, or GitHub environment secrets.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/abide"
APP_TIME_ZONE="Europe/London"

# Single-user login for the public app. Use real private values in deployment.
ABIDE_AUTH_USERNAME="your-username"
ABIDE_AUTH_PASSWORD="replace-with-a-long-password"
ABIDE_SESSION_SECRET="replace-with-a-random-32-byte-secret"

# Daily reflection reminders. Generate a VAPID key pair with:
#   npm run push:keys
# VAPID_SUBJECT may be a mailto: address or an https: URL.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace-with-the-generated-public-key"
VAPID_PRIVATE_KEY="replace-with-the-generated-private-key"
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret for the Vercel cron request that sends the 8pm reminder.
# Set the same value in Vercel. Vercel adds it as a Bearer token automatically.
CRON_SECRET="replace-with-a-long-random-secret"
